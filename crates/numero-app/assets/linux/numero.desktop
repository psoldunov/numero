# Numero's launcher entry. Install as applications/numero.desktop under
# $XDG_DATA_HOME (~/.local/share) or /usr/share, with icons/hicolor beside
# it. The file name must match the app's Wayland app_id, "numero", so the
# compositor finds this entry and its icon for the window.
[Desktop Entry]
Type=Application
Name=Numero
GenericName=Calculator
Comment=Write sums in plain words and see each answer as you type
Exec=numero-app
Icon=numero
Terminal=false
Categories=Utility;Calculator;
Keywords=calculator;math;maths;sum;units;currency;convert;
StartupNotify=true
StartupWMClass=numero
